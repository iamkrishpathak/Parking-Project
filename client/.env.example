# Copy this file to .env and restart the React development server after editing.
# REACT_APP_* values are embedded in the browser bundle. Never put server secrets here.
REACT_APP_API_URL=http://localhost:5001
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Browser API key only: restrict by allowed HTTP referrers and Maps JavaScript API in Google Cloud.
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# DEMO_MAP_ID is suitable for local development; use your configured map ID if applicable.
REACT_APP_GOOGLE_MAP_ID=DEMO_MAP_ID
