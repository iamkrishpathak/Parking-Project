# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:5001

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@parkbandhu.com

# Admin Email
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=ParkBandhu Admin

# Parking-space evidence thresholds; override defaults by property type if needed.
# Example: {"default":{"minimumPhotos":2,"minimumAuthorizationDocuments":1},"residential_society":{"minimumPhotos":3,"minimumAuthorizationDocuments":1,"authorizationGuidance":"Provide society or property-manager permission."}}
SPACE_VERIFICATION_REQUIREMENTS_JSON={"default":{"minimumPhotos":2,"minimumAuthorizationDocuments":1}}
# Set this to a durable private directory in production; never serve it as static/public content.
# PRIVATE_UPLOADS_DIR=/var/lib/parkbandhu/private-uploads
