# Copy this file to .env. Never commit the real .env file or put server secrets in client/.env.

# Server configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Comma-separated exact browser origins only; do not use * with credentialed requests.
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:5001

# MongoDB connection string; use a dedicated, least-privilege database user.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Required. Generate a different secret for each environment: openssl rand -hex 32
# The API refuses to start if this is missing or shorter than 32 bytes.
JWT_SECRET=

# Google OAuth Web client ID (public ID, not a client secret).
# Use the same client ID as REACT_APP_GOOGLE_CLIENT_ID in client/.env.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# SMTP. For Gmail, use an App Password when required, not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# Use a sender identity accepted by your SMTP provider; it may match EMAIL_USER.
EMAIL_FROM=your-verified-sender@example.com

# Optional admin bootstrap. Leave ADMIN_PASSWORD empty to skip auto-creation.
# If set, use a unique strong password stored only in this server environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=ParkBandhu Admin

# Parking-space evidence thresholds; override defaults by property type if needed.
# Example: {"default":{"minimumPhotos":2,"minimumAuthorizationDocuments":1},"residential_society":{"minimumPhotos":3,"minimumAuthorizationDocuments":1,"authorizationGuidance":"Provide society or property-manager permission."}}
SPACE_VERIFICATION_REQUIREMENTS_JSON={"default":{"minimumPhotos":2,"minimumAuthorizationDocuments":1}}

# Set a durable private directory in production. Never serve this directory publicly.
# PRIVATE_UPLOADS_DIR=/var/lib/parkbandhu/private-uploads
